{
  "name": "cookkit",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "expo start -c",
    "ai:dev": "bun run scripts/ai-proxy.ts",
    "ai:smoke": "bun run scripts/smoke-nebius.ts",
    "agent:smoke": "bun run scripts/smoke-agent-stream.ts",
    "android": "expo start -c --android",
    "ios": "expo run ios",
    "web": "expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && tsc --noEmit",
    "lint:fix": "prettier --write .",
    "e2e:fixtures": "bun run scripts/e2e-agent-fixtures.ts",
    "e2e:build:ios": ". ./scripts/e2e-ios-env.sh && detox build -c ios.sim.debug",
    "e2e:test:ios": ". ./scripts/e2e-ios-env.sh && detox test -c ios.sim.debug",
    "e2e:ios": "bun run e2e:build:ios && bun run e2e:test:ios",
    "e2e:build:ios:release": ". ./scripts/e2e-ios-env.sh && detox build -c ios.sim.release",
    "e2e:test:ios:release": ". ./scripts/e2e-ios-env.sh && detox test -c ios.sim.release",
    "e2e:ios:release": "bun run e2e:build:ios:release && bun run e2e:test:ios:release",
    "prepare": "husky",
    "backfill:recipe-images": "bun run scripts/backfill-recipe-images.ts",
    "audit:dependencies": "node scripts/audit-dependencies.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@expo/ui": "~58.0.20",
    "@lucide/lab": "^0.7.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
