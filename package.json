    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@sentry/react-native": "~8.31.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "ai": "^7.0.143",
    "ajv": "8.20.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~58.0.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
