    "neverthrow": "^8.2.0",
    "pluralize": "^8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-image-colors": "^2.6.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-purchases": "^10.14.0",
    "react-native-purchases-ui": "^10.14.0",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "^5.2.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screen-corner-radius": "^0.2.3",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "sonner-native": "^0.27.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.12.2",
    "youtube-transcript": "^1.3.1",
    "zod": "3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@config-plugins/detox": "^11.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-jest": "30.5.2",
    "detox": "^20.51.4",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ws": "^8.22.0"
  },
  "resolutions": {
    "fast-uri": "^3.1.9"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.9",
    "@babel/runtime": ">=7.26.10 <8",
    "tmp": ">=0.2.6",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "uuid": "11.1.1"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true
    }
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@shopify/react-native-skia",
    "detox",
    "dtrace-provider",
    "unrs-resolver"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "patchedDependencies": {
    "react-native-reanimated-carousel@5.2.0": "patches/react-native-reanimated-carousel@5.2.0.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
    "sprintf-js@1.0.3": "patches/sprintf-js@1.0.3.patch",
    "file-type@16.5.4": "patches/file-type@16.5.4.patch",
    "stream-json@1.9.1": "patches/stream-json@1.9.1.patch",
    "@nozbe/watermelondb@0.28.0": "patches/@nozbe%2Fwatermelondb@0.28.0.patch",
    "react-native-screen-corner-radius@0.2.3": "patches/react-native-screen-corner-radius@0.2.3.patch",
    "@expo/ui@58.0.20": "patches/@expo%2Fui@58.0.20.patch",
    "zod@3.25.76": "patches/zod@3.25.76.patch",
    "expo-router@58.0.23": "patches/expo-router@58.0.23.patch"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    },
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
