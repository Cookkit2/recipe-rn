# Environment Variables Template
# Copy this file to .env.local and fill in the actual values
# NEVER commit .env.local or any .env files with real credentials

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat
EXPO_PUBLIC_REVENUECAT_PROJECT_APPLE_API_KEY=your_revenuecat_apple_api_key
EXPO_PUBLIC_REVENUECAT_PROJECT_GOOGLE_API_KEY=your_revenuecat_google_api_key

# Sentry (Expo / @sentry/react-native)
# Upload auth (never ship in the app): EAS Build secrets, or local shell env for `expo run` / Xcode Archive.
# Without this, native debug files / source maps may not upload (see ios/.xcode.env.updates).
SENTRY_AUTH_TOKEN=your_sentry_auth_token
# Must match app.json plugin + sentry.properties (org slug in Sentry URL: Settings → Organization → General).
SENTRY_ORG=cookkit
SENTRY_PROJECT=react-native

# Expo / EAS
EXPO_PROJECT_ID=your_expo_project_id
EXPO_ACCOUNT_OWNER=your_expo_account_owner

# API Keys
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key

# Security - MMKV Encryption (required for encrypted auth storage)
EXPO_PUBLIC_MMKV_ENCRYPTION_KEY=your_32_char_or_more_encryption_key

# E2E Testing (only needed for running E2E tests)
EXPO_PUBLIC_E2E=true

