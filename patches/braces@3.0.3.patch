index 0000000000000000000000000000000000000000..e1b394efd6a422e78de83d7dc1bfac67dbce21ce
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,13 @@
+'use strict';
+
+// Bound every AST entry point, including caller-supplied and cyclic ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || node.nodes == null) continue;
+    if (!Array.isArray(node.nodes)) throw new TypeError('Brace AST nodes must be an array');
+    if (depth > 128) throw new RangeError('Maximum brace nesting depth (128) exceeded');
+    for (const child of node.nodes) pending.push([child, depth + 1]);
+  }
+};
